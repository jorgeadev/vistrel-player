<?xml version="1.0" encoding="utf-8"?>
<!-- Video players are dark-first: the app always uses the dark theme so the window chrome,
     controls and video area read as one surface. -->
<Application
    x:Class="Vistrel.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Brand accent from the logo gradient (#00E5FF → #2962FF), replacing the Windows accent.
           Dark theme draws accent fills with Light2 and hover/pressed with Light3/Light1. -->
      <Color x:Key="SystemAccentColor">#2962FF</Color>
      <Color x:Key="SystemAccentColorLight1">#2E8BFF</Color>
      <Color x:Key="SystemAccentColorLight2">#00C2FF</Color>
      <Color x:Key="SystemAccentColorLight3">#00E5FF</Color>
      <Color x:Key="SystemAccentColorDark1">#2453E0</Color>
      <Color x:Key="SystemAccentColorDark2">#1C41B3</Color>
      <Color x:Key="SystemAccentColorDark3">#142F82</Color>

      <!-- One chrome colour for the title bar and control bar; pure black behind the video. -->
      <Color x:Key="VistrelChromeColor">#12151B</Color>
      <SolidColorBrush x:Key="VistrelChromeBrush" Color="#12151B" />
      <SolidColorBrush x:Key="VistrelVideoBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="VistrelChromeDividerBrush" Color="#1F242D" />
      <SolidColorBrush x:Key="VistrelSecondaryTextBrush" Color="#9AA4B5" />

      <LinearGradientBrush x:Key="VistrelBrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00E5FF" Offset="0" />
        <GradientStop Color="#2962FF" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Application.Resources>
</Application>
