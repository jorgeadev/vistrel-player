<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Vistrel.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="VistrelCyan">#00E5FF</Color>
      <Color x:Key="VistrelBlue">#2962FF</Color>
      <LinearGradientBrush x:Key="VistrelBrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00E5FF" Offset="0" />
        <GradientStop Color="#2962FF" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Application.Resources>
</Application>
