<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vistrel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:local="using:Vistrel.App"
    xmlns:vm="using:Vistrel.App.ViewModels"
    Title="Vistrel Player">

  <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
        Background="{StaticResource VistrelChromeBrush}" KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Space" Invoked="Accel_PlayPause" />
      <KeyboardAccelerator Key="K" Invoked="Accel_PlayPause" />
      <KeyboardAccelerator Key="Left" Invoked="Accel_SeekBack" />
      <KeyboardAccelerator Key="Right" Invoked="Accel_SeekForward" />
      <KeyboardAccelerator Key="J" Invoked="Accel_JumpBack" />
      <KeyboardAccelerator Key="L" Invoked="Accel_JumpForward" />
      <KeyboardAccelerator Key="Up" Invoked="Accel_VolumeUp" />
      <KeyboardAccelerator Key="Down" Invoked="Accel_VolumeDown" />
      <KeyboardAccelerator Key="M" Invoked="Accel_Mute" />
      <KeyboardAccelerator Key="F" Invoked="Accel_Fullscreen" />
      <KeyboardAccelerator Key="F11" Invoked="Accel_Fullscreen" />
      <KeyboardAccelerator Key="Escape" Invoked="Accel_ExitFullscreen" />
      <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Accel_Open" />
      <KeyboardAccelerator Key="G" Invoked="Accel_SubtitlesEarlier" />
      <KeyboardAccelerator Key="H" Invoked="Accel_SubtitlesLater" />
      <KeyboardAccelerator Key="V" Invoked="Accel_CycleSubtitles" />
      <KeyboardAccelerator Key="B" Invoked="Accel_CycleAudio" />
      <KeyboardAccelerator Key="Home" Invoked="Accel_StartOver" />
    </Grid.KeyboardAccelerators>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Custom title bar: same colour as the control bar; the system caption buttons sit on the right. -->
    <Grid x:Name="AppTitleBar" Height="40" Background="{StaticResource VistrelChromeBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png" Width="16" Height="16"
               AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="AppTitleText" Text="{x:Bind Vm.Title, Mode=OneWay}" VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource VistrelSecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>

    <!-- Video surface -->
    <Grid Grid.Row="1" Background="{StaticResource VistrelVideoBackgroundBrush}" DoubleTapped="Video_DoubleTapped">
      <vlc:VideoView x:Name="VideoView" Initialized="VideoView_Initialized"
                     AutomationProperties.Name="Video" />

      <!-- Empty state: shown until a file is opened -->
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                  Visibility="{x:Bind local:MainWindow.CollapsedWhen(Vm.HasMedia), Mode=OneWay}">
        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="104" Height="104"
               AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="Vistrel Player" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <Button x:Name="OpenHeroButton" Click="Open_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="Open a video">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
            <TextBlock Text="Open a video" />
          </StackPanel>
        </Button>
        <TextBlock Text="or drop a file here  ·  Ctrl+O" Foreground="{StaticResource VistrelSecondaryTextBrush}" HorizontalAlignment="Center" />

        <!-- Recent files: click to continue where you left off -->
        <StackPanel Width="520" Margin="0,20,0,0" Spacing="4"
                    Visibility="{x:Bind local:MainWindow.VisibleWhen(Vm.HasRecentFiles), Mode=OneWay}">
          <Grid>
            <TextBlock Text="Recent" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <HyperlinkButton Content="Clear history" HorizontalAlignment="Right" Padding="6,2"
                             Command="{x:Bind Vm.ClearHistoryCommand}"
                             ToolTipService.ToolTip="Forget recent files and resume positions" />
          </Grid>
          <ListView ItemsSource="{x:Bind Vm.RecentFiles}" SelectionMode="None" IsItemClickEnabled="True"
                    ItemClick="RecentFiles_ItemClick" MaxHeight="300" AutomationProperties.Name="Recent files">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentFileItem">
                <Grid Padding="0,8" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Path}"
                      AutomationProperties.Name="{x:Bind Name}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE714;" FontSize="18" VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource VistrelSecondaryTextBrush}" />
                    <ProgressBar Value="{x:Bind Progress}" Maximum="1" Margin="0,4,0,0"
                                 Visibility="{x:Bind local:MainWindow.VisibleWhen(HasProgress)}"
                                 AutomationProperties.AccessibilityView="Raw" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </StackPanel>

      <InfoBar IsOpen="{x:Bind Vm.HasError, Mode=OneWay}" Severity="Error" Title="Can't play this file"
               Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" VerticalAlignment="Top" Margin="16"
               CloseButtonCommand="{x:Bind Vm.DismissErrorCommand}" />

      <!-- On-screen message for quick feedback (volume, delays, track changes) -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Padding="16,8"
              CornerRadius="8" Background="#B3000000" IsHitTestVisible="False"
              Visibility="{x:Bind local:MainWindow.VisibleWhen(Vm.IsOsdVisible), Mode=OneWay}">
        <TextBlock Text="{x:Bind Vm.OsdText, Mode=OneWay}" Foreground="White" FontSize="16"
                   AutomationProperties.LiveSetting="Polite" />
      </Border>
    </Grid>

    <!-- Transport controls -->
    <Grid x:Name="ControlBar" Grid.Row="2" Padding="12,8" ColumnSpacing="6"
          Background="{StaticResource VistrelChromeBrush}"
          BorderBrush="{StaticResource VistrelChromeDividerBrush}" BorderThickness="0,1,0,0">
      <Grid.Resources>
        <!-- Disabled buttons (nothing loaded yet) stay flat too; only the dimmed icon shows. -->
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
        <!-- Flat icon buttons: no box until hovered, like other media players. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Padding" Value="10,8" />
        </Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Command="{x:Bind Vm.TogglePlayPauseCommand}" IsEnabled="{x:Bind Vm.HasMedia, Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind Vm.PlayPauseLabel, Mode=OneWay}"
              AutomationProperties.Name="{x:Bind Vm.PlayPauseLabel, Mode=OneWay}">
        <FontIcon Glyph="{x:Bind Vm.PlayPauseGlyph, Mode=OneWay}" FontSize="16" />
      </Button>

      <TextBlock Grid.Column="1" Text="{x:Bind Vm.PositionText, Mode=OneWay}" VerticalAlignment="Center"
                 MinWidth="48" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />

      <Slider Grid.Column="2" x:Name="SeekBar" Minimum="0" Maximum="{x:Bind Vm.DurationSeconds, Mode=OneWay}"
              Value="{x:Bind Vm.PositionSeconds, Mode=TwoWay}" IsEnabled="{x:Bind Vm.HasMedia, Mode=OneWay}"
              StepFrequency="0.5" SmallChange="5" LargeChange="30" VerticalAlignment="Center"
              IsThumbToolTipEnabled="False" AutomationProperties.Name="Seek" />

      <TextBlock Grid.Column="3" Text="{x:Bind Vm.DurationText, Mode=OneWay}" VerticalAlignment="Center"
                 MinWidth="48" Style="{StaticResource CaptionTextBlockStyle}" />

      <Button Grid.Column="4" Command="{x:Bind Vm.ToggleMuteCommand}" ToolTipService.ToolTip="Mute (M)"
              AutomationProperties.Name="Mute">
        <FontIcon Glyph="{x:Bind Vm.MuteGlyph, Mode=OneWay}" FontSize="16" />
      </Button>

      <Slider Grid.Column="5" Width="110" Minimum="0" Maximum="200" StepFrequency="1" VerticalAlignment="Center"
              Value="{x:Bind Vm.Volume, Mode=TwoWay}" AutomationProperties.Name="Volume"
              ToolTipService.ToolTip="Volume (Up / Down), up to 200%" />

      <Button Grid.Column="6" IsEnabled="{x:Bind Vm.HasMedia, Mode=OneWay}"
              ToolTipService.ToolTip="Audio track and delay (B)" AutomationProperties.Name="Audio track">
        <FontIcon Glyph="&#xE8D6;" FontSize="16" />
        <Button.Flyout>
          <MenuFlyout x:Name="AudioMenu" Placement="Top" Opening="AudioMenu_Opening" />
        </Button.Flyout>
      </Button>

      <Button Grid.Column="7" IsEnabled="{x:Bind Vm.HasMedia, Mode=OneWay}"
              ToolTipService.ToolTip="Subtitles (V)" AutomationProperties.Name="Subtitles">
        <FontIcon Glyph="&#xE7F0;" FontSize="16" />
        <Button.Flyout>
          <MenuFlyout x:Name="SubtitleMenu" Placement="Top" Opening="SubtitleMenu_Opening" />
        </Button.Flyout>
      </Button>

      <DropDownButton Grid.Column="8" Background="Transparent" BorderBrush="Transparent" Content="{x:Bind Vm.RateText, Mode=OneWay}" AutomationProperties.Name="Playback speed"
                      ToolTipService.ToolTip="Playback speed">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="Top">
            <MenuFlyoutItem Text="0.25×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="0.25" />
            <MenuFlyoutItem Text="0.5×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="0.5" />
            <MenuFlyoutItem Text="0.75×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="0.75" />
            <MenuFlyoutItem Text="1× (normal)" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="1" />
            <MenuFlyoutItem Text="1.25×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="1.25" />
            <MenuFlyoutItem Text="1.5×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="1.5" />
            <MenuFlyoutItem Text="2×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="2" />
            <MenuFlyoutItem Text="3×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="3" />
            <MenuFlyoutItem Text="4×" Command="{x:Bind Vm.SetRateCommand}" CommandParameter="4" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>

      <Button Grid.Column="9" Click="Open_Click" ToolTipService.ToolTip="Open file (Ctrl+O)" AutomationProperties.Name="Open file">
        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
      </Button>

      <Button Grid.Column="10" Click="Fullscreen_Click" ToolTipService.ToolTip="Full screen (F)" AutomationProperties.Name="Full screen">
        <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
      </Button>
    </Grid>
  </Grid>
</Window>
