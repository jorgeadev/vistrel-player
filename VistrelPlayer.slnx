<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <!-- The WinUI app has no Any CPU build; it maps to x64 unless ARM64 is selected. -->
    <Project Path="src/Vistrel.App/Vistrel.App.csproj">
      <Platform Solution="*|Any CPU" Project="x64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
    </Project>
    <Project Path="src/Vistrel.Core/Vistrel.Core.csproj" />
    <Project Path="src/Vistrel.Playback.Vlc/Vistrel.Playback.Vlc.csproj" />
    <Project Path="src/Vistrel.Subtitles/Vistrel.Subtitles.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Vistrel.Core.Tests/Vistrel.Core.Tests.csproj" />
    <Project Path="tests/Vistrel.Subtitles.Tests/Vistrel.Subtitles.Tests.csproj" />
    <Project Path="tests/Vistrel.Playback.Vlc.Tests/Vistrel.Playback.Vlc.Tests.csproj" />
  </Folder>
</Solution>
