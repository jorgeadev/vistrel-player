<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- App platform -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Playback (LibVLC is LGPL-2.1, loaded dynamically) -->
    <PackageVersion Include="LibVLCSharp.WinUI" Version="3.10.2" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <!-- Logging (local files only, no telemetry) -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
